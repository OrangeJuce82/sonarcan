{
  "name": "sonarcan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --dependencies",
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test src/lib/*.test.ts",
    "test:mlx": "PYTHONPATH=tools/sonarcan-mlx-worker/src python3 -m unittest discover -s tools/sonarcan-mlx-worker/tests -v",
    "mlx:sync": "uv sync --project tools/sonarcan-mlx-worker --locked",
    "mlx:model": "bash scripts/prepare-mlx-model.sh",
    "mlx:runtime": "bash scripts/build-mlx-runtime.sh",
    "ffmpeg:runtime": "bash scripts/build-ffmpeg-runtime.sh",
    "verify:mlx-release": "bash scripts/verify-mlx-release.sh",
    "verify:ffmpeg-release": "bash scripts/verify-ffmpeg-release.sh",
    "verify:release-version": "bash scripts/verify-release-version.sh",
    "sign:release-resources": "bash scripts/sign-mlx-runtime.sh",
    "build:macos:app": "npm run tauri build -- --target aarch64-apple-darwin --bundles app",
    "build:macos:dmg": "npm run tauri build -- --target aarch64-apple-darwin --bundles dmg",
    "register:macos-app": "bash scripts/register-macos-app.sh",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --locked",
    "quality": "npm run check && npm run test && npm run test:mlx && npm run build && npm run format:rust && npm run lint:rust && npm run test:rust",
    "security:npm": "npm audit --package-lock-only --audit-level=low",
    "security:osv": "osv-scanner scan source --recursive --config osv-scanner.toml .",
    "security": "npm run security:npm && npm run security:osv",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.0.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
