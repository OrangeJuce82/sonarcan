{
  "name": "sonarcan",
  "private": true,
  "version": "0.1.1-beta.5",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --dependencies",
    "dev": "vite",
    "dev:prepare": "node scripts/prepare-analysis-dev.mjs",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test src/lib/*.test.ts",
    "test:mlx": "node scripts/test-python-worker.mjs mlx",
    "test:stems": "node scripts/test-python-worker.mjs torch",
    "test:chords": "node scripts/test-chord-worker.mjs",
    "chords:downbeat-model": "node scripts/prepare-beat-this-model.mjs",
    "python:runtime": "node scripts/build-python-runtime.mjs",
    "executorch:audit": "node scripts/run-executorch-audit.mjs",
    "executorch:probe": "node scripts/build-executorch-probe.mjs",
    "executorch:runtime": "node scripts/build-executorch-runtime.mjs",
    "test:executorch-runtime": "node scripts/test-executorch-runtime.mjs",
    "verify:gpu-runtime": "node scripts/verify-gpu-runtime.mjs",
    "chords:runtime": "npm run python:runtime",
    "verify:chord-release": "node scripts/verify-chord-runtime.mjs",
    "ytdlp:search": "node scripts/prepare-ytdlp-search.mjs",
    "verify:ytdlp-search-release": "node scripts/prepare-ytdlp-search.mjs --verify",
    "mlx:sync": "uv sync --project tools/sonarcan-mlx-worker --locked --reinstall-package sonarcan-scnet-infer",
    "mlx:runtime": "npm run python:runtime",
    "stems:sync": "uv sync --project tools/sonarcan-torch-worker --locked --reinstall-package sonarcan-scnet-infer",
    "stems:runtime": "npm run python:runtime",
    "ffmpeg:runtime": "node scripts/prepare-audio-tools.mjs",
    "verify:audio-tools-source": "node scripts/verify-audio-tools-source.mjs",
    "verify:mlx-release": "node scripts/verify-stem-runtime.mjs",
    "verify:stem-release": "node scripts/verify-stem-runtime.mjs",
    "qualify:stem-performance": "node scripts/qualify-stem-performance.mjs",
    "verify:ffmpeg-release": "node scripts/verify-audio-tools.mjs",
    "verify:bundled-release": "node scripts/verify-bundled-release.mjs",
    "verify:release-version": "bash scripts/verify-release-version.sh",
    "sign:release-resources": "bash scripts/sign-python-runtime.sh",
    "build:macos:app": "npm run tauri build -- --target aarch64-apple-darwin --bundles app",
    "build:macos:dmg": "npm run tauri build -- --target aarch64-apple-darwin --bundles dmg",
    "build:ci": "npm run tauri build -- --no-bundle --config src-tauri/tauri.ci.conf.json",
    "register:macos-app": "bash scripts/register-macos-app.sh",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --locked",
    "quality:shared": "npm run check && npm run test && npm run build && npm run format:rust && npm run lint:rust && npm run test:rust",
    "quality": "npm run test:mlx && npm run test:stems && npm run test:chords && npm run quality:shared",
    "security:npm": "npm audit --package-lock-only --audit-level=low",
    "security:osv": "osv-scanner scan source --recursive --config osv-scanner.toml .",
    "security": "npm run security:npm && npm run security:osv",
    "tauri": "node scripts/run-tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.0.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
