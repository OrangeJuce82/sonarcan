{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonArcan",
  "version": "0.1.0",
  "identifier": "music.sonarcan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run verify:mlx-release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SonArcan",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/mlx-runtime": "mlx-runtime",
      "resources/models/demucs-mlx": "models/demucs-mlx"
    },
    "icon": [],
    "targets": "all",
    "category": "Music",
    "shortDescription": "Professional music learning workspace",
    "longDescription": "Learn, isolate, analyze, and rehearse music in one focused workspace.",
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
