# ============================================================
# SonArcan
# ============================================================


# ------------------------------------------------------------
# macOS
# ------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride

# Finder metadata
._*

# macOS volume metadata
.Spotlight-V100
.Trashes


# ------------------------------------------------------------
# Editors / IDE
# ------------------------------------------------------------

.idea/
.vscode/

*.swp
*.swo
*~
*.tmp


# ------------------------------------------------------------
# Node / npm / Vite / Svelte
# ------------------------------------------------------------

node_modules/

dist/
build/
.svelte-kit/
.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Keep lockfile
!package-lock.json


# ------------------------------------------------------------
# Rust / Cargo / Tauri
# ------------------------------------------------------------

target/
src-tauri/target/

# Generated Tauri schemas
src-tauri/gen/schemas/


# ------------------------------------------------------------
# Generated SonArcan Python runtimes
#
# These are built/generated by the runtime build scripts and
# must not be committed as tens of thousands of individual files.
# ------------------------------------------------------------

src-tauri/resources/chord-runtime/runtime/
src-tauri/resources/mlx-runtime/runtime/
src-tauri/resources/python-runtime/runtime/
src-tauri/resources/stem-runtime/runtime/

# Release resources are reproducibly downloaded or built by the preparation
# scripts. Keep only the instructions needed to recreate them in Git.
src-tauri/resources/audio-tools/*
!src-tauri/resources/audio-tools/README.md
src-tauri/resources/ytdlp-search/yt-dlp
src-tauri/resources/models/demucs-mlx/*.safetensors
src-tauri/resources/models/demucs-mlx/*_config.json
src-tauri/resources/models/beat-this/*.ckpt
release-artifacts/


# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build metadata
*.egg-info/
.eggs/
pip-wheel-metadata/
wheelhouse/


# ------------------------------------------------------------
# Python worker generated files
# ------------------------------------------------------------

tools/**/__pycache__/
tools/**/*.egg-info/


# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx


# ------------------------------------------------------------
# Logs / temporary files
# ------------------------------------------------------------

*.log
logs/

tmp/
temp/
.cache/


# ------------------------------------------------------------
# Test / coverage artifacts
# ------------------------------------------------------------

coverage/
.nyc_output/


# ------------------------------------------------------------
# Generated project-tree / debugging dumps
# ------------------------------------------------------------

sonarcan.txt


# ------------------------------------------------------------
# Local SonArcan project/test files
# ------------------------------------------------------------

*.sac~
*.sac.tmp
